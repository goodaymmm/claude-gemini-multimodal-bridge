{
  "compilerOptions": {
    "target": "ES2022",
    // NodeNext, not ESNext + node10. node10 resolution is deprecated and stops
    // working in TypeScript 7.0, and the two options must move together --
    // moduleResolution: NodeNext alone fails with TS5110.
    //
    // NodeNext over bundler: nothing bundles this package. It is "type":
    // "module" and Node executes the emitted files directly, so relative
    // imports need their .js extension. bundler resolution permits omitting it,
    // which would turn a compile-time error into one the user hits at runtime.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "removeComments": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "preserveConstEnums": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "output",
    "logs",
    "temp",
    "tmp",
    ".cgmb-cache",
    "test-files",
    "examples/output",
    "**/*.js",
    "scripts/**/*.cjs",
    "*.md"
  ],
  "ts-node": {
    "esm": true
  }
}